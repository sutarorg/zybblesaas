# ============================================================================
# Zybble — environment reference
# ============================================================================
#
# There are exactly three environments that hold configuration:
#
#   1. Vercel → Project → Settings → Environment Variables  (server + browser)
#   2. Railway → Service → Variables                       (worker only)
#   3. Supabase → project settings / Auth / Storage         (platform)
#
# Secrets never cross those boundaries. Specifically, none of
# SUPABASE_SECRET_KEY, GEMINI_API_KEY, RAZORPAY_KEY_SECRET or
# RAZORPAY_WEBHOOK_SECRET may ever be given a VITE_ prefix (anything with that
# prefix is compiled into the browser bundle).
#
# Copy this file to `.env.local` for local development only. `.env*` is
# git-ignored except for this reference file.

# ============================================================================
# 1. Vercel — browser bundle (public by definition)
# ============================================================================
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=
# Publishable key (`sb_publishable_…`). Legacy anon JWT also works.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional alias of the above for projects that have not rotated keys yet.
# VITE_SUPABASE_ANON_KEY=
# Optional: only set this when the SPA is served from a different host than the
# API. Leave empty to use same-origin `/api/...` (the normal Vercel setup).
VITE_API_BASE_URL=

# ============================================================================
# 2. Vercel — server side (API functions). Never exposed to the browser.
# ============================================================================
# The API reads SUPABASE_URL first, then falls back to VITE_SUPABASE_URL.
SUPABASE_URL=
# Server key that bypasses RLS: `sb_secret_…` (or the legacy service-role JWT).
SUPABASE_SECRET_KEY=
# Public origin of the app, used in emails and links. Defaults to https://zybble.com
APP_URL=https://zybble.com

# --- Google Gemini (AI planning, analysis, scoring, chat) --------------------
GEMINI_API_KEY=
# Planning model (default: gemini-2.5-pro).
GEMINI_MODEL=gemini-2.5-pro
# Fast model used for short turns (default: gemini-2.5-flash).
GEMINI_FAST_MODEL=gemini-2.5-flash
# Override only for a proxy or a regional endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Razorpay (USD subscriptions) -------------------------------------------
# Public key id (also used to create Checkout on the server).
RAZORPAY_KEY_ID=
# Secret key. Server-side signature verification and API calls only.
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard (Settings → Webhooks).
RAZORPAY_WEBHOOK_SECRET=
# Account region: `us` for international USD accounts, `in` for India-first.
RAZORPAY_REGION=us
# Optional but recommended: plan ids you created in the Razorpay dashboard, one
# per paid Zybble plan code. When they are empty the API creates the Razorpay
# plan on the first checkout and caches the id in `plans.razorpay_plan_id`.
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=

# ============================================================================
# 3. Railway — worker service
# ============================================================================
# Supabase Postgres connection string. Use the **direct** connection (port 5432)
# or the session pooler — not the transaction pooler — because the worker holds
# long-lived connections. `sslmode=require` is mandatory.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Storage access for export files (private bucket).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EXPORTS_BUCKET=zybble-exports

APP_URL=https://zybble.com

# AI jobs. Without this key the worker fails AI jobs with a clear error instead
# of silently skipping them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBEDDINGS_MODEL=gemini-embedding-001

# Identity of this worker in logs and in ops.worker_register.
WORKER_ID=
WORKER_VERSION=1.0.0

# --- Engine behaviour --------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_MAX_DEPTH=10
# Standard mode is the default; fast mode needs coordinates and is opt-in.
WORKER_FAST_MODE=false
# Email extraction runs after the Maps pass and never blocks initial results.
WORKER_EMAIL_EXTRACTION=true
WORKER_EXTRA_REVIEWS=false
WORKER_LANGUAGE=en
# Comma-separated proxies, e.g. http://user:pass@host:8080,socks5://host:1080
WORKER_PROXIES=
WORKER_BROWSER_POOL_SIZE=0
WORKER_MAX_PAGES_PER_BROWSER=0
WORKER_DISABLE_PAGE_REUSE=false
WORKER_EXIT_ON_INACTIVITY=3m

# --- Queue loop ---------------------------------------------------------------
WORKER_JOB_TYPES=scrape,export,ai_lead_scoring,ai_lead_analysis,notification,cleanup
WORKER_MAX_JOBS_PER_POLL=1
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_INTERVAL=15s
WORKER_POLL_INTERVAL=1s
WORKER_SHUTDOWN_TIMEOUT=90s
WORKER_MAX_CONCURRENT_SCRAPES=1
WORKER_CLEANUP_INTERVAL=1h

# --- Lead persistence cadence --------------------------------------------------
WORKER_LEAD_FLUSH_INTERVAL=3s
WORKER_LEAD_FLUSH_SIZE=5
WORKER_PROGRESS_THROTTLE=2s

# --- Health server -------------------------------------------------------------
# Railway injects PORT; PORT_ADDR wins if both are set. Default :8080
PORT_ADDR=:8080

# --- Notification email (optional) ---------------------------------------------
# Without these the worker records "not emailed" on the notification instead of
# pretending a message was sent.
RESEND_API_KEY=
EMAIL_FROM=Zybble <hello@zybble.com>

# Google Maps telemetry must stay off for the Zybble worker. The image sets this
# and config.Load() re-forces it unless it is explicitly "0".
DISABLE_TELEMETRY=1
